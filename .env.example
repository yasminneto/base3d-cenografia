# Supabase - obrigatório
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# URL da aplicação (opcional - usado em links self-referencial, OAuth callbacks)
APP_URL="https://seu-app.vercel.app"

# Gemini AI (opcional - apenas se usar funcionalidades de IA)
GEMINI_API_KEY="sua-gemini-api-key"

# SMTP - obrigatório para envio de e-mails de proposta (lib/emailService.ts)
FREELAHUB_SMTP_HOST="smtp.gmail.com"
FREELAHUB_SMTP_PORT="465"
FREELAHUB_SMTP_SECURE="true"
FREELAHUB_SMTP_USER="seu-usuario-smtp"
FREELAHUB_SMTP_PASS="sua-senha-smtp"
FREELAHUB_EMAIL_FROM="Freela Hub <seu-usuario-smtp>"
FREELAHUB_PUBLIC_APP_URL="https://seu-app.vercel.app"
